# Base de datos local (servidor)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Opcional, para metadatos Open Graph
# SITE_URL=http://localhost:3000

# Segunda etapa — solo servidor, nunca NEXT_PUBLIC_ ni archivos del frontend
# OPENROUTER_API_KEY=

# Segunda etapa — modelo OpenRouter (puedes cambiarlo por un slug disponible)
# OPENROUTER_MODEL=openrouter/free
